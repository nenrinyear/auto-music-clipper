{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "pnpm run build:wasm && vite --port 8787",
    "start": "pnpm run build:ui && vite preview --port 8787",
    "build:wasm": "node ./scripts/build-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "test:ci": "vitest run",
    "check:deploy": "pnpm run build:ui && wrangler deploy --dry-run",
    "benchmark:wasm": "node ./scripts/benchmark-wasm.mjs",
    "test": "vitest",
    "test:browser": "pnpm run build:ui && playwright test",
    "build": "pnpm run build:wasm && pnpm run build:ui",
    "build:ui": "vite build"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.5.2",
    "vite": "^8.3.8",
    "vitest": "~4.1.0",
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "packageManager": "pnpm@10.26.2"
}
